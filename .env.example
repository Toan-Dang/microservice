# Copy thành .env :  cp .env.example .env
# ⚠️ KHÔNG commit file .env thật lên git.

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-strong

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Rate limit (api-gateway) ---
# Chống bot/script quét spam các route REST public (vd GET /products không JWT).
# Mặc định 20 request / 10s / IP nếu không set 2 biến này.
THROTTLE_TTL_MS=10000
THROTTLE_LIMIT=20

# --- Seed (chỉ dev) ---
# docker-compose.yml đã set SEED_ON_BOOT=true cho auth-service & product-service.
# Prod KHÔNG set biến này nên không seed. Chạy tay: npm run seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345

# --- AWS / ECR (dùng cho prod & CI/CD) ---
# Ví dụ: 123456789012.dkr.ecr.ap-southeast-1.amazonaws.com
ECR_REGISTRY=
AWS_REGION=ap-southeast-1
TAG=latest

# --- Email (để trống = mock, không gửi thật) ---
SES_FROM_EMAIL=

# --- gRPC client (order-service -> product-service) ---
# Ngưỡng timeout cho CheckStock, tránh treo request tạo đơn khi product-service phản hồi chậm.
PRODUCT_GRPC_TIMEOUT_MS=3000
